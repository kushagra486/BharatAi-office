GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Max employees with an active tool-use loop at the same time.
MAX_CONCURRENT_SESSIONS=4
# Optional: set this to require a login screen (a single shared password,
# not per-user accounts). Leave blank to keep the app open, no login.
APP_PASSWORD=

# --- Supabase (replaces the old local SQLite Hive + raw WebSocket server) ---
# Server-side only (frontend/app/api/**, the persistent worker) — never
# exposed to the browser. Get SUPABASE_SERVICE_ROLE_KEY from the Supabase
# dashboard (Project Settings > API) — it's not obtainable via the MCP
# tooling used to set this project up, by design (it bypasses Row Level
# Security entirely).
SUPABASE_URL=https://xtphzskbnsmahqrzppnw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Browser-exposed (Next.js NEXT_PUBLIC_ vars are bundled into client code) —
# safe because RLS restricts the anon key to read-only. Used for Realtime
# subscriptions (tasks/messages/escalations/brief) and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://xtphzskbnsmahqrzppnw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_aPPHuHlKJ0fgy-Ial7PZHA_9LciHPFw
