GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Shared secret for GET /api/cron/nova-tick (frontend/app/api/cron/nova-tick/
# route.ts). Set this on the Vercel project, and set the identical value as
# the CRON_SECRET GitHub Actions secret so .github/workflows/nova-tick.yml
# can call the endpoint on a real 5-minute cadence — Vercel's own Hobby-plan
# cron only fires once a day, too slow for escalation triage/QA.
CRON_SECRET=
# Max employees with an active tool-use loop at the same time.
MAX_CONCURRENT_SESSIONS=4
# Optional: set this to require a login screen (a single shared password,
# not per-user accounts). Leave blank to keep the app open, no login.
APP_PASSWORD=

# --- Supabase (replaces the old local SQLite Hive + raw WebSocket server) ---
# Server-side only (frontend/app/api/**, the persistent worker) — never
# exposed to the browser. Get SUPABASE_SERVICE_ROLE_KEY from the Supabase
# dashboard (Project Settings > API) — it's not obtainable via the MCP
# tooling used to set this project up, by design (it bypasses Row Level
# Security entirely).
SUPABASE_URL=https://xtphzskbnsmahqrzppnw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Browser-exposed (Next.js NEXT_PUBLIC_ vars are bundled into client code) —
# safe because RLS restricts the anon key to read-only. Used for Realtime
# subscriptions (tasks/messages/escalations/brief) and nothing else.
#
# Use the LEGACY JWT anon key here, not the newer sb_publishable_... one:
# Supabase Realtime's websocket handshake validates the JWT `role` claim
# directly and doesn't yet accept the new publishable-key format — using it
# here made every Realtime connection fail with a 500 during the handshake
# (REST reads worked fine, since PostgREST does support the new format).
# Get this from the Supabase dashboard (Project Settings > API > Legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=https://xtphzskbnsmahqrzppnw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh0cGh6c2tibnNtYWhxcnpwcG53Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1Nzk2NTYsImV4cCI6MjEwNTE1NTY1Nn0.M_iPjYnNmDxFJ7KP_1Q7COtN0tlun8_2EYb7oZaWoHQ
